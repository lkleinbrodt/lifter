{
  "expo": {
    "name": "lifter",
    "slug": "lifter",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lifter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lkleinbrodt.lifter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "DU26G2LJFP"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "./plugins/without-push-entitlement",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/rest-tick-1.wav",
            "./assets/sounds/rest-tick-2.wav",
            "./assets/sounds/rest-tick-3.wav",
            "./assets/sounds/rest-tick-4.wav",
            "./assets/sounds/rest-tick-5.wav",
            "./assets/sounds/rest-over-jarvis.wav",
            "./assets/sounds/rest-over-elle.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b847e9da-adbc-405d-9ac0-43ba6968e8f4"
      }
    },
    "owner": "lkleinbrodt",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "url": "https://u.expo.dev/b847e9da-adbc-405d-9ac0-43ba6968e8f4",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
